{
    auto_https off
    admin off
}

https://{$BENKA_PANEL_HOST}:8443 {
    tls /run/tls/server.crt /run/tls/server.key {
        client_auth {
            mode require_and_verify
            trust_pool file /run/tls/client-ca.crt
        }
    }
    header Strict-Transport-Security "max-age=31536000"
    reverse_proxy gateway:9119
}
